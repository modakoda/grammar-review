#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
source scripts/lib/swift-tools.sh

files=()
while IFS= read -r -d '' file; do
  files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift')
((${#files[@]} == 0)) && exit 0

require_tool swiftformat
require_tool swiftlint
use_command_line_tools_sourcekit

status=0
swiftformat "${files[@]}" --lint --quiet || status=1
swiftlint lint --strict --quiet --force-exclude "${files[@]}" || status=1

if ((status != 0)); then
  echo "pre-commit: fix the problems above (scripts/format.sh fixes formatting), or commit with --no-verify." >&2
fi
exit "$status"
